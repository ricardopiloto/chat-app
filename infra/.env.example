# Copy to infra/.env if you override LiveKit keys (must match livekit.yaml `keys:`).
# Backend reads these from the environment when you `cargo run` in backend/.

LIVEKIT_API_KEY=instkey
LIVEKIT_API_SECRET=instsecretinstsecretinstsecret12
LIVEKIT_WS_URL=ws://127.0.0.1:7880

# Backend
DATABASE_URL=sqlite://chat.db?mode=rwc
BIND=0.0.0.0:8080
COOKIE_SECURE=false
SESSION_TTL_SECS=604800
DEFAULT_INVITE_TTL_SECS=604800

# --- Registo e e-mail (change email-registration) ---------------------------------------------
# Formato: uma variável por linha, `CHAVE=valor`, SEM comentário na mesma linha (com `docker env_file` ou
# `systemd` o comentário passaria a fazer parte do valor). Valores com espaços ou `< >` vão entre aspas.
# O backend NÃO carrega este ficheiro sozinho: exporte as variáveis no shell antes de arrancar
# (por exemplo `set -a; . infra/.env; set +a`) ou passe-as ao serviço (systemd, Docker, ...).
#
# Modo de registo: `fechado` (padrão; convite obrigatório depois da primeira conta) ou `aberto`
# (um e-mail verificado dispensa o convite). Qualquer outro valor impede o arranque.
REGISTO_MODO=fechado
# opcional; pedido de recuperação por e-mail, desligado por padrão
# RESET_EMAIL=true
#
# Necessários com REGISTO_MODO=aberto ou RESET_EMAIL=true. Em produção (PARLEY_PRODUCTION=1) o arranque exige
# EMAIL_API_KEY, EMAIL_FROM, PUBLIC_BASE_URL HTTPS pública e TRUSTED_PROXY=true.
# chave da API do Resend; ausente = envia só para o log (desenvolvimento)
# EMAIL_API_KEY=
# remetente de um domínio verificado no Resend (SPF/DKIM)
# EMAIL_FROM="Parley <no-reply@exemplo.com>"
# endereço público da app, usado no link do e-mail (ex.: https://chat.exemplo.com)
# PUBLIC_BASE_URL=
#
# Desenvolvimento: sem EMAIL_API_KEY, grava o ficheiro `<EMAIL_LOG_FILE>` (diagnóstico) e
# `<EMAIL_LOG_FILE com extensão .eml>` (e-mail completo, com o link). Não use em produção.
# EMAIL_LOG_FILE=./data/mail/mail.log
#
# Atrás do Nginx: usa o cabeçalho X-Real-IP (só aceite quando a ligação vem de loopback) para o
# limite por IP dos pedidos de e-mail. Configure `proxy_set_header X-Real-IP $remote_addr;`.
# TRUSTED_PROXY=true
#
# Antispam opcional: captcha Cloudflare Turnstile e lista extra de domínios descartáveis (um por linha).
# TURNSTILE_SECRET=
# TURNSTILE_SITE_KEY=
# REGISTO_DOMINIOS_BLOQUEADOS=./data/dominios-bloqueados.txt
