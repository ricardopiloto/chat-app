{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: open HTTP and WebSocket scope, plus the instance store.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*:*" },
        { "url": "http://*/*" },
        { "url": "http://*:*/*" },
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "https://*/*" },
        { "url": "https://*:*/*" }
      ]
    },
    "websocket:default",
    "store:default"
  ]
}
