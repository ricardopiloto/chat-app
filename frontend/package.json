{
  "name": "chat-frontend-v2",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint src",
    "format": "prettier --write src",
    "check:v1-overlap": "node scripts/check-v1-overlap.mjs",
    "test:contracts": "node --experimental-strip-types scripts/contracts/run.mjs && node --experimental-strip-types scripts/contracts/run.mjs --impl scripts/contracts/impl-v2.mjs",
    "verify:chat": "node scripts/verify-chat.mjs",
    "verify:i18n-keys": "node scripts/verify-i18n-keys.mjs",
    "verify:sound": "node scripts/verify-sound.mjs",
    "verify:last-channel": "node scripts/verify-last-channel.mjs",
    "verify:mentions": "node scripts/verify-mentions.mjs"
  },
  "dependencies": {
    "@livekit/track-processors": "^0.7.2",
    "@noble/hashes": "^1.8.0",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.66.0",
    "hash-wasm": "^4.12.0",
    "livekit-client": "^2.22.3",
    "solid-js": "^1.9.9",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.43.0",
    "vite": "^6.3.0",
    "vite-plugin-solid": "^2.11.8"
  }
}
